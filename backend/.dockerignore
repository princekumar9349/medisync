# ─── Python compiled files ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ─── Virtual environments ─────────────────────────────────────────────────────
venv/
env/
myenv/
.venv/

# ─── Sensitive files (NEVER in image) ─────────────────────────────────────────
.env
.env.*
env.yaml
*.env
# firebase/serviceAccountKey.json is required for FCM
# firebase/*.json

# ─── Development tools ────────────────────────────────────────────────────────
.git/
.github/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ─── Test artifacts ───────────────────────────────────────────────────────────
.pytest_cache/
tests/
test_*.py
*_test.py
htmlcov/
.coverage
coverage.xml

# ─── Documentation ────────────────────────────────────────────────────────────
docs/
*.md
!README.md

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Build artifacts ──────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
