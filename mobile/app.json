{
  "expo": {
    "name": "Medisync",
    "slug": "medisync-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D9488"
    },
    "android": {
      "package": "com.medisync.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D9488"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.medisync.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Medisync needs camera access to scan prescriptions.",
        "NSPhotoLibraryUsageDescription": "Medisync needs photo library access to upload prescriptions.",
        "NSMicrophoneUsageDescription": "Medisync uses microphone for voice commands and chatbot interaction."
      }
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "ios": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Medisync to access your photos to upload prescriptions.",
          "cameraPermission": "Allow Medisync to use your camera to scan prescriptions."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D9488"
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "23041707-83ef-4fa1-a303-8a1145b4b4e8"
      }
    }
  }
}
