# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — Environment variable template
#
# IMPORTANT:
#   - DO NOT commit .env or env.yaml with real values
#   - Copy this to .env for local development
#   - Set real values via GitHub Secrets + Cloud Run --set-env-vars in CI/CD
#   - For local dev, fill in your actual keys below
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment (development | staging | production) ──────────────────────────
ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=MediSync
MONGO_DB_NAME=medisync_db

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Providers ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ── Observability ─────────────────────────────────────────────────────────────
# Get DSN from: https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://your-key@sentry.io/project-id

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "false" on API replicas if running separate scheduler container
SCHEDULER_ENABLED=true

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to serviceAccountKey.json (relative to backend root)
FIREBASE_CREDENTIALS=firebase/serviceAccountKey.json

# ── OTP / Messaging ───────────────────────────────────────────────────────────
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE=123456

# ── Twilio (Optional — for voice calls) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP — for password reset) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
